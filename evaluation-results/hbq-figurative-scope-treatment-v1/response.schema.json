{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HBQ figurative scope treatment response",
  "type": "object",
  "required": ["request_id", "study_id", "arm", "partition", "case_id", "leaf_id", "repeat", "artifact_sha256", "controller_scope_materiality", "controller_scope_verdict", "revision_note", "verdict", "evidence", "provider_provenance"],
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string", "pattern": "^fst-v1-"},
    "study_id": {"const": "hbq-figurative-scope-treatment-v1"},
    "arm": {"enum": ["baseline", "scope_rendering_only"]},
    "partition": {"const": "development"},
    "case_id": {"type": "string", "minLength": 1},
    "leaf_id": {"enum": ["core.freshness_and_non_genericness.no_default_metaphors", "penalty.purple_prose.proportion", "penalty.purple_prose.fatigue"]},
    "repeat": {"type": "integer", "minimum": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controller_scope_materiality": {"enum": ["not_applicable", "revision_note", "scope_failure", "cannot_assess"]},
    "controller_scope_verdict": {"enum": ["YES", "NO", null]},
    "revision_note": {"type": ["string", "null"]},
    "verdict": {"enum": ["YES", "NO", "NOT_APPLICABLE", "CANNOT_ASSESS"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["reference", "quote"], "additionalProperties": false, "properties": {"reference": {"type": "string"}, "quote": {"type": "string"}}}},
    "provider_provenance": {"type": "object", "required": ["route", "model", "reasoning", "run_id"], "additionalProperties": false, "properties": {"route": {"type": "string"}, "model": {"type": "string"}, "reasoning": {"type": "string"}, "run_id": {"type": "string"}}}
  }
}
