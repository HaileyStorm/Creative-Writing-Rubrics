      "artifact_type": "poetry",
      "leaves": ["form.poetry.general_poetry.image_relation", "form.poetry.prose_poem.image_system"],
      "conditions": [
        {"condition_id": "both-yes", "artifact_name": "artifact-07.txt", "completion_status": "complete", "text": "The orchard keeps receipts in its bark. By noon the receipts become moths, and the moths settle on my father's empty coat until the coat begins to leaf.", "expected": ["YES", "YES"]},
        {"condition_id": "prose-poem-routing", "artifact_name": "artifact-08.txt", "completion_status": "complete", "text": "The moon enters the spoon, then the spoon darkens the soup; the table's silver travels through the room and changes each witness's face. The passage is supplied as a lyric fragment, not as a prose poem.", "expected": ["YES", "NOT_APPLICABLE"]},
        {"condition_id": "both-no", "artifact_name": "artifact-09.txt", "completion_status": "complete", "text": "A red umbrella stands by the door. A bird is on the wire. A cup is on the table. The images do not alter or develop one another.", "expected": ["NO", "NO"]},
        {"condition_id": "coverage-ablation", "artifact_name": "artifact-10.txt", "completion_status": "unknown", "text": "The supplied note says images occur elsewhere, but no poetic passage is present.", "expected": ["CANNOT_ASSESS", "CANNOT_ASSESS"]},
        {"condition_id": "inactive-control", "artifact_name": "artifact-11.txt", "completion_status": "complete", "text": "Submission metadata only; no poem or image evidence is supplied.", "expected": ["NOT_APPLICABLE", "NOT_APPLICABLE"]},
        {"condition_id": "second-both-yes", "artifact_name": "artifact-12.txt", "completion_status": "complete", "text": "A cracked bell fills with rain. The rain becomes a small choir, and the choir's breath opens the bell into a blue doorway.", "expected": ["YES", "YES"]}
