      "conditions": [
        {"condition_id": "both-yes", "artifact_name": "artifact-01.txt", "completion_status": "complete", "text": "The elevator forgets each floor.\nAt every stop, I name the missing neighbor.\nThe cables hum their borrowed names.\nBy dawn, the building remembers us in reverse.", "expected": ["YES", "YES"]},
        {"condition_id": "form-only", "artifact_name": "artifact-02.txt", "completion_status": "complete", "text": "A hinge opens.\nA hinge closes.\nThe line breaks make the hinge pause,\nbut no movement changes beyond the repeated action.", "expected": ["YES", "NO"]},
        {"condition_id": "scope-only", "artifact_name": "artifact-03.txt", "completion_status": "complete", "text": "We inherit a weather map.\nThe first stanza names rain, the next names debt,\nand the final stanza returns the map as a will.\nThe movement is complete, though the line breaks are arbitrary.", "expected": ["NO", "YES"]},
        {"condition_id": "both-no", "artifact_name": "artifact-04.txt", "completion_status": "complete", "text": "The street is quiet.\nA lamp is bright.\nA car goes past.\nNothing changes or gathers.", "expected": ["NO", "NO"]},
        {"condition_id": "coverage-ablation", "artifact_name": "artifact-05.txt", "completion_status": "unknown", "text": "Fragment retained without the rest of the poem or its declared scope.", "expected": ["CANNOT_ASSESS", "CANNOT_ASSESS"]},
        {"condition_id": "inactive-control", "artifact_name": "artifact-06.txt", "completion_status": "complete", "text": "Catalog record: title only; no poem is supplied for evaluation.", "expected": ["NOT_APPLICABLE", "NOT_APPLICABLE"]}
      ]
    },
    {
