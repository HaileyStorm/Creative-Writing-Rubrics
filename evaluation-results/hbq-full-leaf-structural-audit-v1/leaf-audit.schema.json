{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HBQ full-leaf structural-audit row",
  "type": "object",
  "required": ["format", "audit", "ordinal", "qid", "criterion_key", "owner", "provenance", "routing", "question", "ownership", "polarity", "scope", "evidence", "materiality", "finding_ids"],
  "properties": {
    "format": {"const": "hbq-full-leaf-structural-audit-row-v1"}, "audit": {"const": "hbq-full-leaf-structural-audit-v1"}, "ordinal": {"type": "integer", "minimum": 1}, "qid": {"type": "string", "minLength": 1}, "criterion_key": {"type": "string", "minLength": 1},
    "owner": {"type": "object", "required": ["module_id", "version", "path", "kind", "domains"], "properties": {"module_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "path": {"type": "string", "pattern": "^registry/modules/.+\\.yaml$"}, "kind": {"type": "string", "minLength": 1}, "domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "provenance": {"type": "object", "required": ["module_sha256", "origin", "research_basis", "source_inventory_entry"], "properties": {"module_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "origin": {"type": ["string", "null"]}, "research_basis": {"type": "array", "items": {"type": "string"}}, "source_inventory_entry": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["section", "subsection", "source_title", "source_description", "module_id", "question_count"], "properties": {"section": {"type": "string", "minLength": 1}, "subsection": {"type": "string"}, "source_title": {"type": "string", "minLength": 1}, "source_description": {"type": "string", "minLength": 1}, "module_id": {"type": "string", "minLength": 1}, "question_count": {"type": "integer", "minimum": 1}}, "additionalProperties": false}]}}, "additionalProperties": false},
    "routing": {"type": "object", "required": ["artifact_types", "valid_scopes", "default_evidence_scope", "selected_bundles"], "properties": {"artifact_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "valid_scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "default_evidence_scope": {"type": "object"}, "selected_bundles": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "question": {"type": "object", "required": ["text", "type", "weight", "groups"], "properties": {"text": {"type": "string", "minLength": 1}, "type": {"enum": ["hard_gate", "scored", "subjective_threshold", "diagnostic"]}, "weight": {"type": "number", "exclusiveMinimum": 0}, "groups": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "ownership": {"type": "object", "required": ["criterion_key_equals_qid", "criterion_key_unique", "flags"], "properties": {"criterion_key_equals_qid": {"type": "boolean"}, "criterion_key_unique": {"type": "boolean"}, "flags": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "polarity": {"type": "object", "required": ["pass_answer", "orientation", "surface_construction", "rules"], "properties": {"pass_answer": {"const": "YES"}, "orientation": {"const": "positive_yes"}, "surface_construction": {"enum": ["affirmative_surface", "negative_surface"]}, "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "scope": {"type": "object", "required": ["signal", "specificity", "rules", "flags"], "properties": {"signal": {"enum": ["local", "cross_unit", "cumulative", "whole"]}, "specificity": {"enum": ["local_or_unspecified", "explicit"]}, "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "flags": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["required", "minimum_references", "reference_style", "specificity", "flags"], "properties": {"required": {"type": "boolean"}, "minimum_references": {"type": "integer", "minimum": 0}, "reference_style": {"type": ["string", "null"]}, "specificity": {"enum": ["minimum_reference_required", "not_declared"]}, "flags": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "materiality": {"type": "object", "required": ["severity", "cues", "specificity", "flags"], "properties": {"severity": {"const": "material"}, "cues": {"type": "array", "items": {"type": "string"}}, "specificity": {"const": "declared_material"}, "flags": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "finding_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }, "additionalProperties": false
}
