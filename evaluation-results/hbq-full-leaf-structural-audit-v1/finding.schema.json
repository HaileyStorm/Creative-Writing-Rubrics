{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "HBQ full-leaf structural-audit candidate finding", "type": "object",
  "required": ["finding_id", "format", "audit", "kind", "subjects", "rule", "raw_scores", "routing_evidence", "first_remedy", "interpretation"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "format": {"const": "hbq-full-leaf-structural-audit-finding-v1"}, "audit": {"const": "hbq-full-leaf-structural-audit-v1"},
    "kind": {"enum": ["lexical_overlap", "scope_binding_review", "polarity_change"]}, "subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "rule": {"type": "object", "minProperties": 1},
    "raw_scores": {"type": "object", "required": ["token_jaccard", "shared_content_tokens", "shorter_containment", "fourgram_dice"], "properties": {"token_jaccard": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "shared_content_tokens": {"type": "array", "items": {"type": "string"}}, "shorter_containment": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "fourgram_dice": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "routing_evidence": {"type": "object", "minProperties": 1, "anyOf": [{"required": ["common_artifact_types", "common_valid_scopes", "common_selected_bundles", "same_module"]}, {"required": ["artifact_types", "valid_scopes", "selected_bundles"]}]},
    "first_remedy": {"type": "object", "required": ["selection", "selected", "eligible"], "properties": {"selection": {"enum": ["none", "eligible_static_signal", "bound_empirical_signal"]}, "selected": {"const": null}, "eligible": {"type": "array", "items": {"enum": ["localized_vs_scope_conflict", "polarity_change"]}}}, "additionalProperties": false}, "interpretation": {"type": "string", "minLength": 1}
  }, "additionalProperties": false
}
