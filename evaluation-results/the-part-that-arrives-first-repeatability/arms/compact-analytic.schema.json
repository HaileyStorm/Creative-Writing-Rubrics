{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "dimensions", "overall_score", "overall_rationale"],
  "properties": {
    "method": {"const": "compact_analytic_v1"},
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "score", "rationale", "evidence"],
        "properties": {
          "dimension_id": {
            "enum": [
              "narrative_architecture",
              "character_relationships",
              "worldbuilding_integration",
              "prose_voice",
              "emotional_reader_effect",
              "thematic_complexity"
            ]
          },
          "score": {"type": "integer", "minimum": 1, "maximum": 5},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "explanation"],
              "properties": {
                "quote": {"type": "string", "minLength": 1, "maxLength": 500},
                "explanation": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "overall_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "overall_rationale": {"type": "string", "minLength": 1}
  }
}
