{
  "type": "object",
  "additionalProperties": false,
  "required": ["overall", "rationale", "evidence"],
  "properties": {
    "overall": {"type": "integer", "minimum": 1, "maximum": 7},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 900},
    "evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "explanation"],
        "properties": {
          "quote": {"type": "string", "minLength": 1, "maxLength": 320},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 480}
        }
      }
    }
  }
}
