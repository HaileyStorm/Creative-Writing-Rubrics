{
  "type": "object",
  "additionalProperties": false,
  "required": ["overall", "dimensions", "rationale", "evidence"],
  "properties": {
    "overall": {"type": "integer", "minimum": 1, "maximum": 5},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clarity", "coherence", "specificity", "control"],
      "properties": {
        "clarity": {"type": "integer", "minimum": 1, "maximum": 5},
        "coherence": {"type": "integer", "minimum": 1, "maximum": 5},
        "specificity": {"type": "integer", "minimum": 1, "maximum": 5},
        "control": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 900},
    "evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "explanation"],
        "properties": {
          "quote": {"type": "string", "minLength": 1, "maxLength": 320},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 480}
        }
      }
    }
  }
}
