{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "result",
    "abstention_reason"
  ],
  "properties": {
    "status": {
      "enum": [
        "SCORED",
        "CANNOT_ASSESS"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "method",
        "score",
        "rationale",
        "strengths",
        "limitations",
        "evidence"
      ],
      "properties": {
        "method": {
          "enum": [
            "holistic_anchored_ttcw_v1"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "strengths": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quote",
              "explanation"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "abstention_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1600
    }
  }
}
