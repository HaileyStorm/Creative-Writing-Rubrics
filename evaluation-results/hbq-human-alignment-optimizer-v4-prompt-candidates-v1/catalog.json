    {"candidate_id": "hanna-v4-pc-local-01", "mechanism": "anchored-evidence-contrast", "source": {"provider": "nous", "model": "deepseek/deepseek-v4-flash-0731", "source_candidate_index": 0, "source_mechanism": "Anchored contrast: floor and ceiling searches", "source_prompt_sha256": "d69a3bc410fbcf6e44a86584903c10d572ee6a867d38026ecbeafba2bd9d868c", "derivation": "new_local_descendant_rewrite"}, "mechanical_class": "low-high-evidence-contrast", "instruction": {"common_prefix_ref": "luna-source.json#/common_prefix", "local_delta": "For each dimension, separately seek evidence consistent with low realization and evidence consistent with strong realization. Use the contrast to test calibration, not to invent a missing extreme: assign the supplied scale value warranted by the strongest observable evidence for that dimension. Keep the six contrast checks independent and return only the required schema."}, "instruction_sha256": "2c78c29ed78cc5a0965a5c6f2f3b26176eb607b209445706ef6f5690acb7d749"},
    {"candidate_id": "hanna-v4-pc-local-02", "mechanism": "counterfactual-sensitivity", "source": {"provider": "nous", "model": "deepseek/deepseek-v4-flash-0731", "source_candidate_index": 1, "source_mechanism": "Counterfactual upgrade and degrade tests", "source_prompt_sha256": "14ba11c8e4be47f3347d7dd4ec42ce7b2c4d1b518d304b016f7d6c409c15347a", "derivation": "new_local_descendant_rewrite"}, "mechanical_class": "minimal-change-sensitivity", "instruction": {"common_prefix_ref": "luna-source.json#/common_prefix", "local_delta": "For each dimension, test whether a small plausible edit to the supplied material would materially change its realization. Use that sensitivity check only to identify the observed margin between weak, middling, and strong construction; do not award an imagined improvement or penalize an imagined deletion. Score the supplied artifact alone, independently for all six dimensions, and return only the required schema."}, "instruction_sha256": "8d8df87c4b26484d4351558c1cea168f7b00721b1de80cbe9e5240e1d683d328"},
    {"candidate_id": "hanna-v4-pc-local-03", "mechanism": "dimension-failure-screen", "source": {"provider": "nous", "model": "deepseek/deepseek-v4-flash-0731", "source_candidate_index": 2, "source_mechanism": "Per-dimension failure-mode caps", "source_prompt_sha256": "9c7a3cfe1a004e2b6fcfde0ca0b6b986da43fbfb3dbd68770ecfb018cee6f87c", "derivation": "new_local_descendant_rewrite"}, "mechanical_class": "dimension-specific-adversarial-screen", "instruction": {"common_prefix_ref": "luna-source.json#/common_prefix", "local_delta": "Before each dimension score, run a narrow adversarial screen for a breakdown in that dimension only: topic drift for Relevance; event, time, or reference inconsistency for Coherence; unsupported feeling attunement for Empathy; an unfitting or absent development for Surprise; loss of attention for Engagement; or missing layered inference for Complexity. A screen finding is evidence to weigh, never an automatic cap, and cannot affect another dimension. Return only the required schema."}, "instruction_sha256": "82eeb2c311afe5cb59c98d4361133c594697e8e3922c5f89f06673dc41a11b46"},
    {"candidate_id": "hanna-v4-pc-local-04", "mechanism": "single-flaw-halo-audit", "source": {"provider": "nous", "model": "deepseek/deepseek-v4-flash-0731", "source_candidate_index": 7, "source_mechanism": "Severity-first scoring with halo guard", "source_prompt_sha256": "117dadacad58447325645517d82c6a5b83f147cc8cdcf05313034e7c014464b7", "derivation": "new_local_descendant_rewrite"}, "mechanical_class": "negative-halo-isolation", "instruction": {"common_prefix_ref": "luna-source.json#/common_prefix", "local_delta": "After assigning the six independent scores, identify whether one conspicuous weakness has pulled any other dimension away from its own evidence. Recheck only the affected dimension definitions and observations; retain a score unless its own construction warrants change. Do not let a single flaw create a global penalty or suppress an independently realized strength. Return only the required schema."}, "instruction_sha256": "4944c3df5c72f7b9330c47f282aae97d76c57b0b24932facd8d35f119586c0da"}
