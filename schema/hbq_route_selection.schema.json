{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HaileyStorm/Creative-Writing-Rubrics/main/schema/hbq_route_selection.schema.json",
  "title": "HBQ-RS automated route selection",
  "type": "object",
  "required": [
    "route_version",
    "artifact_profile",
    "selected_bundle_id",
    "selected_module_ids",
    "selection_reasons",
    "sampling_plan",
    "task_contract"
  ],
  "properties": {
    "route_version": {"const": 1},
    "artifact_profile": {
      "type": "object",
      "required": ["artifact_kind", "declared_scope", "completion_status", "unit_count", "source_sha256"],
      "properties": {
        "artifact_kind": {"type": "string", "minLength": 1},
        "declared_scope": {"type": "string", "minLength": 1},
        "completion_status": {"enum": ["complete", "work_in_progress", "excerpt", "unknown"]},
        "unit_count": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "selected_bundle_id": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
    "selected_module_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
      "uniqueItems": true
    },
    "selection_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 129,
      "items": {
        "type": "object",
        "required": ["catalog_id", "reason"],
        "properties": {
          "catalog_id": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "sampling_plan": {
      "type": "object",
      "required": ["coverage_mode", "unit_ids", "strata", "global_map_required", "rationale"],
      "properties": {
        "coverage_mode": {"enum": ["complete", "sampled"], "description": "complete covers every unit marked local_evaluation.eligible; sampled is allowed only by an explicit caller bound."},
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"},
          "uniqueItems": true
        },
        "strata": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "unit_ids"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "unit_ids": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "global_map_required": {"const": true},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "task_contract": {
      "$ref": "#/$defs/task_contract"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "reference", "exact_excerpt"],
      "properties": {
        "kind": {
          "enum": [
            "explicit_user_requirement",
            "formal_specification",
            "driving_prompt",
            "user_preference"
          ]
        },
        "reference": {"type": "string", "minLength": 1},
        "exact_excerpt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "context_item": {
      "type": "object",
      "required": ["id", "statement", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    },
    "weighted_goal": {
      "type": "object",
      "required": ["goal_id", "atomic_question", "weight", "source", "applies_to", "rationale"],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "atomic_question": {"type": "string", "minLength": 4, "pattern": "\\?$"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "source": {"$ref": "#/$defs/source"},
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "binding_requirement": {
      "type": "object",
      "required": ["requirement_id", "atomic_question", "objective", "non_negotiable", "source", "applies_to", "verification"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "atomic_question": {"type": "string", "minLength": 4, "pattern": "\\?$"},
        "objective": {"const": true},
        "non_negotiable": {"const": true},
        "source": {
          "type": "object",
          "required": ["kind", "reference", "exact_excerpt"],
          "properties": {
            "kind": {"enum": ["explicit_user_requirement", "formal_specification"]},
            "reference": {"type": "string", "minLength": 1},
            "exact_excerpt": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "verification": {
          "type": "object",
          "description": "For method absence, YES means the prohibited condition is absent and NO means it is present; absence alone is never NOT_APPLICABLE or CANNOT_ASSESS.",
          "required": ["method", "expected"],
          "properties": {
            "method": {"enum": ["exact_match", "presence", "absence", "numeric_limit", "enumerated_constraint", "structural_constraint"]},
            "expected": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "task_contract": {
      "type": "object",
      "required": ["contract_version", "contract_id", "artifact_id", "context", "preferences", "priorities", "weighted_goals", "binding_requirements"],
      "properties": {
        "contract_version": {"const": 1},
        "contract_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "artifact_id": {"type": "string", "minLength": 1},
        "context": {
          "type": "object",
          "required": ["artifact_kind", "declared_scope", "completion_status", "background", "constraints", "audience"],
          "properties": {
            "artifact_kind": {"type": "string", "minLength": 1},
            "declared_scope": {"type": "string", "minLength": 1},
            "completion_status": {"enum": ["complete", "work_in_progress", "excerpt", "unknown"]},
            "background": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "audience": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "preferences": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/context_item"}},
        "priorities": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/context_item"}},
        "weighted_goals": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/weighted_goal"}},
        "binding_requirements": {"type": "array", "maxItems": 64, "description": "Automatic route selection must leave this empty; a validated caller override may replace the task contract after model routing.", "items": {"$ref": "#/$defs/binding_requirement"}}
      },
      "additionalProperties": false
    }
  }
}
