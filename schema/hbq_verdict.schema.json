{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HaileyStorm/Creative-Writing-Rubrics/main/schema/hbq_verdict.schema.json",
  "title": "HBQ-RS question verdict",
  "type": "object",
  "required": [
    "artifact_id",
    "bundle_id",
    "question_id",
    "verdict",
    "confidence",
    "evidence"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "question_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "YES",
        "NO",
        "NOT_APPLICABLE",
        "CANNOT_ASSESS"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "\\S"
          },
          "exact_quote": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 500
          },
          "quote": {
            "type": "string",
            "description": "Legacy untyped evidence retained for normalized historical verdict compatibility; new judge responses use exact_quote or summary.",
            "maxLength": 500
          }
        },
        "oneOf": [
          {
            "required": [
              "exact_quote"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "summary"
                  ]
                },
                {
                  "required": [
                    "quote"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "summary"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "exact_quote"
                  ]
                },
                {
                  "required": [
                    "quote"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "quote"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "exact_quote"
                  ]
                },
                {
                  "required": [
                    "summary"
                  ]
                }
              ]
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "exact_quote"
                  ]
                },
                {
                  "required": [
                    "summary"
                  ]
                },
                {
                  "required": [
                    "quote"
                  ]
                }
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "judge_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
