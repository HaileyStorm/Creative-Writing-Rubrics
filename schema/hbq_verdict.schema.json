{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HaileyStorm/Creative-Writing-Rubrics/main/schema/hbq_verdict.schema.json",
  "title": "HBQ-RS question verdict",
  "type": "object",
  "required": [
    "artifact_id",
    "bundle_id",
    "question_id",
    "verdict",
    "confidence",
    "evidence"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "question_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "YES",
        "NO",
        "NOT_APPLICABLE",
        "CANNOT_ASSESS"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": true
      }
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "judge_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
