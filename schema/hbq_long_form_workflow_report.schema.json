{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HaileyStorm/Creative-Writing-Rubrics/main/schema/hbq_long_form_workflow_report.schema.json",
  "title": "HBQ-RS long-form workflow report",
  "type": "object",
  "required": [
    "report_version",
    "artifact",
    "route",
    "completion_contract",
    "orientation",
    "global_result",
    "local_results",
    "hierarchical_score",
    "findings",
    "warnings"
  ],
  "properties": {
    "report_version": {"const": 1},
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "source_sha256", "unit_count"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "unit_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["global_bundle_id", "local_bundle_id", "local_bundle_mode", "module_ids", "weighted_goal_count", "binding_requirement_count", "local_coverage_mode", "local_unit_ids", "non_substantive_unit_ids"],
      "properties": {
        "global_bundle_id": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
        "local_bundle_id": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
        "local_bundle_mode": {"enum": ["scope_auto", "explicit", "explicit_global_deep", "global_fallback_no_scope_bundle", "global_fallback_mixed_or_nonchapter"]},
        "module_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.]+$"}, "uniqueItems": true},
        "weighted_goal_count": {"type": "integer", "minimum": 0},
        "binding_requirement_count": {"type": "integer", "minimum": 0},
        "local_coverage_mode": {"enum": ["complete", "sampled"], "description": "complete covers all substantive deterministic units; sampled is an explicit diagnostic reduction."},
        "local_unit_ids": {"type": "array", "minItems": 1, "description": "Substantive units evaluated independently in deterministic source order.", "items": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"}, "uniqueItems": true},
        "non_substantive_unit_ids": {"type": "array", "description": "Brief non-prose front-matter units retained in whole-work evaluation but omitted from local diagnostics.", "items": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "completion_contract": {
      "type": "object",
      "required": ["contract_version", "completion_status", "incomplete", "completion_only_criterion_verdict", "unavailable_supplied_evidence_verdict", "assess_supplied_scope_craft", "assess_supplied_scope_continuity", "applicable_binding_requirements", "applicable_weighted_goals"],
      "properties": {
        "contract_version": {"const": 1},
        "completion_status": {"enum": ["complete", "work_in_progress", "excerpt", "unknown"]},
        "incomplete": {"type": "boolean"},
        "completion_only_criterion_verdict": {"enum": ["EVALUATE", "NOT_APPLICABLE", "CANNOT_ASSESS"]},
        "unavailable_supplied_evidence_verdict": {"const": "CANNOT_ASSESS"},
        "assess_supplied_scope_craft": {"const": true},
        "assess_supplied_scope_continuity": {"const": true},
        "applicable_binding_requirements": {"const": "evaluate"},
        "applicable_weighted_goals": {"const": "score"}
      },
      "additionalProperties": false
    },
    "orientation": {
      "type": "object",
      "required": ["premise", "evaluated_scope", "cast"],
      "properties": {
        "premise": {"type": "string", "minLength": 1},
        "evaluated_scope": {"type": "string", "minLength": 1},
        "cast": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "global_result": {
      "anyOf": [
        {"$ref": "#/$defs/result"},
        {"type": "null"}
      ]
    },
    "local_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    },
    "hierarchical_score": {
      "anyOf": [
        {"$ref": "#/$defs/hierarchical_score"},
        {"type": "null"}
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "finding", "why_it_matters", "evidence_refs", "criterion_ids"],
        "properties": {
          "kind": {"enum": ["strength", "risk", "revision_priority", "observation"]},
          "finding": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "criterion_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "$defs": {
    "interval": {
      "type": "object",
      "required": ["observed", "lower", "upper"],
      "properties": {
        "observed": {"type": "number", "minimum": 0, "maximum": 100},
        "lower": {"type": "number", "minimum": 0, "maximum": 100},
        "upper": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "required": ["domain_id", "title", "coverage", "score"],
      "properties": {
        "domain_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "score": {
          "anyOf": [
            {"$ref": "#/$defs/interval"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["scope_id", "label", "control_state", "coverage", "score", "domains"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "control_state": {"enum": ["VALID", "INVALID", "UNRESOLVED", "PROVISIONAL", "INELIGIBLE"]},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "score": {
          "anyOf": [
            {"$ref": "#/$defs/interval"},
            {"type": "null"}
          ]
        },
        "domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}},
        "weight_profile": {"type": ["object", "null"]},
        "confidence_diagnostics": {
          "anyOf": [
            {"$ref": "#/$defs/confidence_diagnostics"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "assessed_effective_weight_threshold_shares": {
      "type": "object",
      "required": ["gte_0_5", "gte_0_75", "gte_0_9"],
      "properties": {
        "gte_0_5": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "gte_0_75": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "gte_0_9": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "confidence_role_aggregate": {
      "type": "object",
      "required": ["question_count", "applicable_count", "assessed_count", "applicable_effective_weight", "assessed_effective_weight", "assessed_raw_confidence_weighted_mean", "assessed_raw_confidence_weighted_median", "assessed_effective_weight_threshold_shares", "effective_confidence_mass"],
      "properties": {
        "question_count": {"type": "integer", "minimum": 0},
        "applicable_count": {"type": "integer", "minimum": 0},
        "assessed_count": {"type": "integer", "minimum": 0},
        "applicable_effective_weight": {"type": "number", "minimum": 0},
        "assessed_effective_weight": {"type": "number", "minimum": 0},
        "assessed_raw_confidence_weighted_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "assessed_raw_confidence_weighted_median": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "assessed_effective_weight_threshold_shares": {"$ref": "#/$defs/assessed_effective_weight_threshold_shares"},
        "effective_confidence_mass": {
          "type": "object",
          "required": ["value", "is_coverage"],
          "properties": {
            "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "is_coverage": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "confidence_diagnostics": {
      "type": "object",
      "required": ["diagnostic_version", "status", "disclosure", "roles", "calibration"],
      "properties": {
        "diagnostic_version": {"const": 1},
        "status": {"const": "DESCRIPTIVE_UNCALIBRATED"},
        "disclosure": {"type": "string", "minLength": 1},
        "roles": {
          "type": "object",
          "required": ["domain", "hard_gate", "penalty", "supplemental"],
          "properties": {
            "domain": {"$ref": "#/$defs/confidence_role_aggregate"},
            "hard_gate": {"$ref": "#/$defs/confidence_role_aggregate"},
            "penalty": {"$ref": "#/$defs/confidence_role_aggregate"},
            "supplemental": {"$ref": "#/$defs/confidence_role_aggregate"}
          },
          "additionalProperties": false
        },
        "calibration": {
          "type": "object",
          "required": ["status", "exact_fingerprint", "reason"],
          "properties": {
            "status": {"const": "UNAVAILABLE"},
            "exact_fingerprint": {"type": "null"},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hierarchical_component": {
      "type": "object",
      "required": ["score", "requested_weight", "effective_weight"],
      "properties": {
        "score": {"anyOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
        "requested_weight": {"type": "number", "minimum": 0},
        "effective_weight": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "hierarchical_score": {
      "type": "object",
      "required": ["profile_version", "profile_id", "method", "local_reducer", "score", "global_component", "local_component", "unit_weight_policy", "policy"],
      "properties": {
        "profile_version": {"const": 1},
        "profile_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "method": {"const": "weighted_global_local"},
        "local_reducer": {"enum": ["weighted_mean", "weakest_unit", "trim_one_per_tail"]},
        "score": {"$ref": "#/$defs/interval"},
        "global_component": {"$ref": "#/$defs/hierarchical_component"},
        "local_component": {
          "type": "object",
          "required": ["score", "requested_weight", "effective_weight", "selected_weakest_unit_id", "trimmed_tail", "unit_weight_assignments"],
          "properties": {
            "score": {"anyOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
            "requested_weight": {"type": "number", "minimum": 0},
            "effective_weight": {"type": "number", "minimum": 0, "maximum": 1},
            "selected_weakest_unit_id": {"anyOf": [{"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"}, {"type": "null"}]},
            "trimmed_tail": {"anyOf": [{"$ref": "#/$defs/trimmed_tail"}, {"type": "null"}]},
            "unit_weight_assignments": {
              "type": "array",
                "items": {
                  "type": "object",
                  "required": ["unit_id", "weight_class", "class_modifier", "effective_weight"],
                  "properties": {
                    "unit_id": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"},
                    "weight_class": {"enum": ["ordinary", "unfinished", "prologue_epilogue"]},
                    "class_modifier": {"type": "number", "minimum": 0},
                    "effective_weight": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "additionalProperties": false
              }
            }
          },
      "additionalProperties": false
    },
    "unit_weight_policy": {
          "type": "object",
          "required": ["ordinary_unit_weight", "unfinished_unit_weight", "unfinished_unit_ids", "prologue_epilogue_weight", "prologue_epilogue_unit_ids", "overlap_precedence"],
          "properties": {
            "ordinary_unit_weight": {"const": 1.0},
            "unfinished_unit_weight": {"type": "number", "minimum": 0},
            "unfinished_unit_ids": {"type": "array", "items": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"}, "uniqueItems": true},
            "prologue_epilogue_weight": {"type": "number", "minimum": 0},
            "prologue_epilogue_unit_ids": {"type": "array", "items": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"}, "uniqueItems": true},
            "overlap_precedence": {"const": "unfinished_before_prologue_epilogue"}
          },
          "additionalProperties": false
        },
        "policy": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"local_reducer": {"const": "trim_one_per_tail"}}, "required": ["local_reducer"]},
          "then": {
            "properties": {
              "local_component": {
                "required": ["trimmed_tail"],
                "properties": {
                  "selected_weakest_unit_id": {"type": "null"},
                  "trimmed_tail": {"$ref": "#/$defs/trimmed_tail"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"local_reducer": {"const": "weakest_unit"}}, "required": ["local_reducer"]},
          "then": {
            "properties": {
              "local_component": {
                "properties": {
                  "selected_weakest_unit_id": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"},
                  "trimmed_tail": {"type": "null"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"local_reducer": {"const": "weighted_mean"}}, "required": ["local_reducer"]},
          "then": {
            "properties": {
              "local_component": {
                "properties": {
                  "selected_weakest_unit_id": {"type": "null"},
                  "trimmed_tail": {"type": "null"}
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "trimmed_tail": {
      "type": "object",
      "required": ["eligible_unit_count", "retained_unit_count", "tie_rule", "excluded_units"],
      "properties": {
        "eligible_unit_count": {"type": "integer", "minimum": 3},
        "retained_unit_count": {"type": "integer", "minimum": 1},
        "tie_rule": {"const": "lowest observed: earliest source-order tie; highest observed: latest source-order tie"},
        "excluded_units": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["unit_id", "role", "weight_class", "source_index", "reason"],
            "properties": {
              "unit_id": {"type": "string", "pattern": "^unit-[0-9]{4}-[0-9a-f]{12}$"},
              "role": {"enum": ["lowest_tail", "highest_tail"]},
              "weight_class": {"enum": ["ordinary", "unfinished", "prologue_epilogue"]},
              "source_index": {"type": "integer", "minimum": 0},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "allOf": [
            {"contains": {"type": "object", "properties": {"role": {"const": "lowest_tail"}}, "required": ["role"]}},
            {"contains": {"type": "object", "properties": {"role": {"const": "highest_tail"}}, "required": ["role"]}}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
